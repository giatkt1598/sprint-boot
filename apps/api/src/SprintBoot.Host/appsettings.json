{
  "Runtime": { "Role": "All" },
  "Auth": { "RequireHttps": true, "SpaBaseUrl": "" },
  "Settings": {
    "Abp.Mailing.DefaultFromAddress": "no-reply@sprintboot.local",
    "Abp.Mailing.DefaultFromDisplayName": "Sprint Boot",
    "Abp.Mailing.Smtp.Host": "localhost",
    "Abp.Mailing.Smtp.Port": "1025",
    "Abp.Mailing.Smtp.EnableSsl": "false",
    "Abp.Mailing.Smtp.UseDefaultCredentials": "true"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sprintboot;Username=sprintboot;Password="
  },
  "Redis": { "Configuration": "localhost:6379" },
  "RabbitMQ": {
    "Connections": {
      "Default": { "HostName": "localhost", "Port": 5672, "UserName": "", "Password": "" }
    },
    "EventBus": { "ClientName": "SprintBoot", "ExchangeName": "SprintBoot" }
  },
  "Storage": {
    "Provider": "Local",
    "Local": { "Path": "data/attachments" },
    "S3": { "Endpoint": "", "Region": "", "Bucket": "", "AccessKey": "", "SecretKey": "" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Volo.Abp": "Warning" }
    }
  }
}
