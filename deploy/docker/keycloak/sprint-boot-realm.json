{
  "realm": "sprint-boot",
  "enabled": true,
  "clients": [
    {
      "clientId": "sprint-boot",
      "secret": "sprint-boot-dev-secret",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "webOrigins": [
        "+"
      ]
    },
    {
      "clientId": "http://localhost:5173/connect/signin-keycloak-saml",
      "name": "Sprint Boot (SAML)",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "attributes": {
        "saml.client.signature": "false",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "persistent",
        "saml_assertion_consumer_url_post": "http://localhost:5173/connect/signin-keycloak-saml/Acs"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "name",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@sso.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Sso",
      "credentials": [
        {
          "type": "password",
          "value": "Sso123!dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "mallory",
      "email": "admin@sprintboot.local",
      "emailVerified": false,
      "enabled": true,
      "firstName": "Mallory",
      "lastName": "Sso",
      "credentials": [
        {
          "type": "password",
          "value": "Sso123!dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "invitee",
      "email": "invitee@sso.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Invitee",
      "lastName": "Sso",
      "credentials": [
        {
          "type": "password",
          "value": "Sso123!dev",
          "temporary": false
        }
      ]
    }
  ]
}
